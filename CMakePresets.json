{
    "version": 3,
    "configurePresets": [
        {
            "name": "release",
            "displayName": "Release",
            "description": "Release build with Ninja and manifest dependencies",
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_MANIFEST_MODE": "ON",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Debug build with Ninja and manifest dependencies",
            "binaryDir": "${sourceDir}/build-debug",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VCPKG_MANIFEST_MODE": "ON",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "release",
            "configuration": "Release"
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "debug",
            "configuration": "Debug"
        }
    ]
}
