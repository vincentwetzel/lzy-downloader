#ifndef APP_VERSION_H
#define APP_VERSION_H

// Auto-generated by CMake from VERSION and LZY_BUILD_NUMBER — do not edit manually

#define APP_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define APP_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define APP_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define APP_VERSION_STRING "@LZY_APP_VERSION@"

// Windows RC file requires comma-separated numeric version
#define APP_VERSION_RC @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@LZY_BUILD_NUMBER@

#endif // APP_VERSION_H
